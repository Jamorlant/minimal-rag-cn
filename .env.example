# 复制为 .env 后按需修改；所有项都有默认值，不配置也能运行。
# 敏感信息（如 LLM Key）只写在本文件，不要提交到仓库。

# ---- 切块与检索 ----
RAG_CHUNK_SIZE=280
RAG_CHUNK_OVERLAP=56
RAG_TOP_K=3
# 稠密分在混合重排中的权重，其余为字符 n-gram 字面分
RAG_RERANK_WEIGHT=0.5
# 最佳命中分低于该值直接拒答
RAG_MIN_HIT_SCORE=0.25

# ---- 向量化 ----
# auto | st（强制 BGE）| ngram（强制离线）
RAG_EMBED_MODE=auto
RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBED_DIM=2048

# ---- 向量库 ----
# auto | chroma | numpy
RAG_STORE=auto

# ---- 生成 ----
# auto | llm | extractive
RAG_LLM_MODE=auto
# 留空则自动使用抽取式兜底
RAG_LLM_API_KEY=
RAG_LLM_BASE_URL=https://api.openai.com/v1
RAG_LLM_MODEL=gpt-4o-mini

# ---- 断言校验 ----
RAG_SUPPORT_THRESHOLD=0.55

# ---- 日志 ----
# DEBUG | INFO | WARNING | ERROR
RAG_LOG_LEVEL=INFO
